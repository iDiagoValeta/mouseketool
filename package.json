{
  "name": "mouseketool",
  "version": "1.2.2",
  "description": "Checks whether public GitHub projects already do what you are about to build, and gives a verdict: reuse, adapt, use as a base, or build.",
  "private": true,
  "type": "module",
  "bin": {
    "mouseketool": "dist/server.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "node scripts/build.mjs",
    "eval": "tsx evals/harness/cli.ts"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
